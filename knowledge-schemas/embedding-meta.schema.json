{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "model": {
      "type": "string"
    },
    "dimensions": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "doc_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "shard_size": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "version",
    "model",
    "dimensions",
    "doc_ids",
    "shard_size"
  ],
  "additionalProperties": false
}
