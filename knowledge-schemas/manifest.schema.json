{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "release_id": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "source_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "service_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "verified_service_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "chunk_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "chunk_shard_size": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "retrieval": {
      "type": "object",
      "properties": {
        "keyword_index": {
          "type": "string"
        },
        "embedding_index": {
          "type": [
            "string",
            "null"
          ]
        },
        "embedding_model": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "keyword_index",
        "embedding_index",
        "embedding_model"
      ],
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          }
        },
        "required": [
          "path",
          "size",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "validation_status": {
      "type": "string",
      "enum": [
        "passed",
        "failed"
      ]
    }
  },
  "required": [
    "release_id",
    "schema_version",
    "generated_at",
    "source_count",
    "service_count",
    "verified_service_count",
    "chunk_count",
    "chunk_shard_size",
    "retrieval",
    "files",
    "validation_status"
  ],
  "additionalProperties": false
}
