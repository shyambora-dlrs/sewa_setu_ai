{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "service_id": {
      "type": "string"
    },
    "updated_by": {
      "type": "string"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "evidence": {
      "type": "object",
      "properties": {
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "note": {
          "type": "string",
          "minLength": 3,
          "maxLength": 2000
        }
      },
      "required": [
        "source_url",
        "note"
      ],
      "additionalProperties": false
    },
    "patch": {
      "type": "object",
      "properties": {
        "service_name_as": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "eligibility": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "application_steps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "designated_authority": {
          "type": [
            "string",
            "null"
          ]
        },
        "delivery_method": {
          "type": [
            "string",
            "null"
          ]
        },
        "processing_time_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "appeal_procedure": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "grievance_procedure": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "service_id",
    "updated_by",
    "updated_at",
    "evidence",
    "patch"
  ],
  "additionalProperties": false
}
