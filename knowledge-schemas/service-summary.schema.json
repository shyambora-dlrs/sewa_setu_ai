{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "service_id": {
      "type": "string"
    },
    "service_name": {
      "type": "string"
    },
    "service_name_as": {
      "type": [
        "string",
        "null"
      ]
    },
    "category": {
      "type": "string"
    },
    "department_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "department_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "publication_status": {
      "type": "string",
      "enum": [
        "draft",
        "verified",
        "rejected"
      ]
    },
    "content_hash": {
      "type": "string"
    },
    "last_verified_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "has_fees": {
      "type": "boolean"
    },
    "has_documents": {
      "type": "boolean"
    },
    "has_steps": {
      "type": "boolean"
    },
    "has_processing_time": {
      "type": "boolean"
    },
    "warning_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "service_id",
    "service_name",
    "service_name_as",
    "category",
    "department_id",
    "department_name",
    "publication_status",
    "content_hash",
    "last_verified_at",
    "has_fees",
    "has_documents",
    "has_steps",
    "has_processing_time",
    "warning_count"
  ],
  "additionalProperties": false
}
