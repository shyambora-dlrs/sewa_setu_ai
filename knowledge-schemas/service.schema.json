{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "service_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,200}$"
    },
    "service_name": {
      "type": "string",
      "minLength": 1
    },
    "service_name_as": {
      "type": [
        "string",
        "null"
      ]
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "department": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "department_id": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "department_id",
            "name"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "eligibility": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "source_chunk_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "text",
          "source_chunk_id"
        ],
        "additionalProperties": false
      }
    },
    "required_documents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "requirement": {
            "type": "string",
            "enum": [
              "mandatory",
              "conditional",
              "optional",
              "unspecified"
            ]
          },
          "applies_to": {
            "type": [
              "string",
              "null"
            ]
          },
          "condition": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_text": {
            "type": "string"
          },
          "source_chunk_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "name",
          "requirement",
          "applies_to",
          "condition",
          "source_text",
          "source_chunk_id"
        ],
        "additionalProperties": false
      }
    },
    "conditional_documents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "requirement": {
            "type": "string",
            "enum": [
              "mandatory",
              "conditional",
              "optional",
              "unspecified"
            ]
          },
          "applies_to": {
            "type": [
              "string",
              "null"
            ]
          },
          "condition": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_text": {
            "type": "string"
          },
          "source_chunk_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "name",
          "requirement",
          "applies_to",
          "condition",
          "source_text",
          "source_chunk_id"
        ],
        "additionalProperties": false
      }
    },
    "application_steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "source_chunk_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "step",
          "text",
          "source_chunk_id"
        ],
        "additionalProperties": false
      }
    },
    "fees": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "published",
            "not_published"
          ]
        },
        "amount": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "currency": {
          "type": "string",
          "const": "INR"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "amount": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "unit": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "condition": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "raw_text": {
                "type": "string"
              }
            },
            "required": [
              "label",
              "amount",
              "unit",
              "condition",
              "raw_text"
            ],
            "additionalProperties": false
          }
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_chunk_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "status",
        "amount",
        "currency",
        "items",
        "conditions",
        "source_chunk_ids"
      ],
      "additionalProperties": false
    },
    "processing_time": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "published",
            "not_published"
          ]
        },
        "value": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "days",
                "working_days",
                "hours",
                "months"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_chunk_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "status",
        "value",
        "unit",
        "text",
        "conditions",
        "source_chunk_ids"
      ],
      "additionalProperties": false
    },
    "designated_authority": {
      "type": [
        "string",
        "null"
      ]
    },
    "delivery_method": {
      "type": [
        "string",
        "null"
      ]
    },
    "rejection_conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "source_chunk_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "text",
          "source_chunk_id"
        ],
        "additionalProperties": false
      }
    },
    "appeal_procedure": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "source_chunk_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "text",
          "source_chunk_id"
        ],
        "additionalProperties": false
      }
    },
    "grievance_procedure": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "source_chunk_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "text",
          "source_chunk_id"
        ],
        "additionalProperties": false
      }
    },
    "application_url": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "null"
        }
      ]
    },
    "official_page_url": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "null"
        }
      ]
    },
    "sources": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "source_url": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "publisher_or_department": {
            "type": [
              "string",
              "null"
            ]
          },
          "document_type": {
            "type": "string",
            "enum": [
              "service_page",
              "directory_page",
              "html_page",
              "pdf",
              "admin_upload"
            ]
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "published_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              {
                "type": "null"
              }
            ]
          },
          "last_modified_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              {
                "type": "null"
              }
            ]
          },
          "content_hash": {
            "type": "string",
            "minLength": 8
          },
          "page_or_section": {
            "type": [
              "string",
              "null"
            ]
          },
          "extraction_method": {
            "type": "string",
            "enum": [
              "html",
              "pdf_text",
              "pdf_ocr",
              "manual"
            ]
          }
        },
        "required": [
          "source_id",
          "source_url",
          "title",
          "publisher_or_department",
          "document_type",
          "retrieved_at",
          "published_at",
          "last_modified_at",
          "content_hash",
          "page_or_section",
          "extraction_method"
        ],
        "additionalProperties": false
      }
    },
    "publication_status": {
      "type": "string",
      "enum": [
        "draft",
        "verified",
        "rejected"
      ]
    },
    "last_verified_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "extracted_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "content_hash": {
      "type": "string",
      "minLength": 8
    },
    "extraction_warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "service_id",
    "service_name",
    "service_name_as",
    "category",
    "department",
    "description",
    "eligibility",
    "required_documents",
    "conditional_documents",
    "application_steps",
    "fees",
    "processing_time",
    "designated_authority",
    "delivery_method",
    "rejection_conditions",
    "appeal_procedure",
    "grievance_procedure",
    "application_url",
    "official_page_url",
    "sources",
    "publication_status",
    "last_verified_at",
    "extracted_at",
    "content_hash",
    "extraction_warnings"
  ],
  "additionalProperties": false
}
