{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "upload_id": {
      "type": "string"
    },
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64
    },
    "filename": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "department": {
      "type": [
        "string",
        "null"
      ]
    },
    "origin": {
      "type": "string"
    },
    "service_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "size": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "uploaded_by": {
      "type": "string"
    },
    "uploaded_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "upload_id",
    "sha256",
    "filename",
    "title",
    "department",
    "origin",
    "service_id",
    "size",
    "uploaded_by",
    "uploaded_at"
  ],
  "additionalProperties": false
}
